# ==============================
# CodeLens - Git Ignore
# ==============================

# ------------------------------
# Node / React / Vite
# ------------------------------
node_modules/
frontend/node_modules/

dist/
frontend/dist/

.vite/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------
# Python / FastAPI
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------
# Backend temporary files
# ------------------------------
backend/tmp/
backend/temp/
backend/repositories/
backend/cloned_repositories/

# Analysis output/cache
backend/.cache/
backend/cache/

# ------------------------------
# OS files
# ------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------
# IDE / Editors
# ------------------------------
.vscode/
.idea/

# VS Code settings that are commonly machine-specific
*.code-workspace

# ------------------------------
# Logs
# ------------------------------
*.log
logs/

# ------------------------------
# Build / generated files
# ------------------------------
*.pyc
*.pyo

# ------------------------------
# Secrets
# ------------------------------
*.pem
*.key
secrets/
credentials/

# ------------------------------
# Local database files
# ------------------------------
*.db
*.sqlite
*.sqlite3